{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tanAI",
  "version": "0.1.0",
  "identifier": "com.tanai.desktop",
  "build": {
    "frontendDist": "../frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "bash src-tauri/prebuild.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tanAI",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#0b0b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["backend/**/*"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
