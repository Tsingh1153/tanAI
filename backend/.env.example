# LocalMind backend configuration.
# Copy to .env and adjust as needed. All variables are optional; defaults work
# out of the box for a local Ollama install.

# Host/port the API server binds to.
LOCALMIND_HOST=127.0.0.1
LOCALMIND_PORT=8000

# Async SQLAlchemy database URL. Default is a local SQLite file.
# For Postgres: postgresql+asyncpg://user:pass@localhost/localmind
LOCALMIND_DATABASE_URL=sqlite+aiosqlite:///./localmind.db

# Ollama server. Change if Ollama runs elsewhere.
LOCALMIND_OLLAMA_BASE_URL=http://localhost:11434

# Model used when a conversation does not specify one.
LOCALMIND_DEFAULT_MODEL=qwen2.5:7b

# Context window in tokens. Ollama defaults to 2048; raise for longer memory.
# Guidance: 8192 for ~16 GB RAM, 32768+ for 32 GB+, up to 131072 for llama3.2.
# Lower (e.g. 4096) is faster and lighter if you don't need long context.
LOCALMIND_NUM_CTX=8192

# Keep the model loaded in memory so replies don't pay a reload delay.
# "30m", "1h", or "-1" to keep it resident while the app runs.
LOCALMIND_OLLAMA_KEEP_ALIVE=30m
# Warm the models at startup so the first message is fast.
LOCALMIND_WARM_UP=true

# Streaming request timeout (seconds).
LOCALMIND_REQUEST_TIMEOUT=300

# Allowed CORS origins (JSON array).
LOCALMIND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Computer use (desktop control) — OFF by default. Enabling lets the agent move
# the mouse, type, and screenshot your real screen (every action still needs
# approval). Requires: pip install -r requirements-computer.txt
LOCALMIND_COMPUTER_USE_ENABLED=false

# Python plugins — drop .py files in this directory to add custom agent tools.
LOCALMIND_PLUGINS_ENABLED=true
LOCALMIND_PLUGINS_DIR=./plugins
